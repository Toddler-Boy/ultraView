{
	"constants": [
		{ "settingsW": "276 + 16" }
	],

	"components": [
		{ "id": "browser", "x": "fullscreen", "y": 0, "w": 364, "b": "parB - bentoGap",
			"components": [
				{ "id": "badge", "x": "bentoGap", "y": 5, "r": "parW - bentoGap", "h": 32,
					"components": [
						{ "id": "chickenlips", "x": 10, "cy": "parH2", "w": 20, "h": "parH2 + 3" },
						{ "id": "logo", "x": "prevR + 8", "cy": "prevCY", "w": 130, "h": "parH2" },
						{ "id": "64", "r": "parW - 12", "cy": "parH2", "w": 48, "h": "parH2" },
						{ "id": "stripes", "x": "getR('logo') + 8", "cy": "parH2", "r": "prevX - 4", "h": "parH2 + 3" }
					]
				},
				{ "id": "background", "x": "bentoGap", "y": "prevB + 10", "r": "parW - bentoGap", "b": "parH",
					"components": [
						{ "id": "label-browse", "factory": "crt-header(browse)", "x": 10, "y": "prevB + 10", "r": "parW - 10", "h": 28 },
						{ "id": "curPath", "x": "prevX + 2", "y": "prevB", "r": "parW - 44", "h": 28 },
						{ "id": "changePath", "xd": 8, "w": "prevH" },
						{ "id": "searchBar", "x": 10, "y": "prevB + 10", "r": "parW - 10", "h": 32 },
						{ "id": "info", "x": "prevX + 4", "y": "prevB + 8", "r": "prevR - 4", "h": 24 },
						{ "id": "listbox", "x": "getX('searchBar')", "y": "prevB + 10", "w": "getW('searchBar')", "b": "parH - bentoMargin" }
					]
				}
			]
		},
		{ "id": "crt", "x": "prevX + showBrowser * prevW", "y": 0, "r": "parW - ( settingsW + bentoGap ) * showSettings - fullscreen", "b": "parH",
			"components": [
				{ "id": "browser", "x": 0, "y": 0 },
				{ "id": "open", "r": "parW", "y": 0 },
				{ "id": "about", "r": "parW", "b": "parH" },
				{ "id": "action-buttons", "b": "parH - 15", "cx": "parW2", "w": 500, "h": 30,
					"components": [
						{ "grid": "menu_button, pause, resume, reboot, poweroff", "bounds": "parent", "cols": 5, "colGap": 5 }
					]
				}
			]
		},

		// The panel's own tree comes from the shared crt-settings.json
		{ "id": "settings", "x": "prevR + bentoGap", "y": "prevY", "r": "parW - bentoGap", "b": "parB - bentoGap" }
	]
}
